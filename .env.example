PI_INGEST_ENVIRONMENT=development
PI_INGEST_LOG_LEVEL=INFO
PI_INGEST_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
PI_INGEST_METRICS_PUSHGATEWAY_URL=http://127.0.0.1:9091
PI_INGEST_DOCS_ENABLED=true
PI_INGEST_FORCE_HTTPS=false
PI_INGEST_WEBHOOK_MAX_BODY_BYTES=2097152
PI_INGEST_CONTROL_PLANE_URL=http://localhost:8001
PI_INGEST_CONTROL_PLANE_API_KEY=
PI_INGEST_GITHUB_APP_ID=
PI_INGEST_GITHUB_PRIVATE_KEY_BASE64=
PI_INGEST_GITHUB_WEBHOOK_SECRET=
PI_INGEST_GITHUB_MAX_FILE_BYTES=1000000
PI_INGEST_PINECONE_API_KEY=
PI_INGEST_ALLOWED_INDEX_HOSTS=
PI_INGEST_STATE_TABLE_ENDPOINT=
PI_INGEST_STATE_TABLE_NAME=piingestionstate
PI_INGEST_STATE_MANAGED_IDENTITY_CLIENT_ID=
PI_INGEST_INTERNAL_API_KEY=
PI_INGEST_INCREMENTAL_OVERLAP_MINUTES=5
PI_INGEST_SOURCE_PAGE_SIZE=100
PI_INGEST_MAX_ATTACHMENT_BYTES=25000000
PI_INGEST_CHUNK_MAX_TOKENS=420
PI_INGEST_CODE_CHUNK_MAX_TOKENS=350
PI_INGEST_TABLE_CHUNK_MAX_TOKENS=300
PI_INGEST_CHUNK_OVERLAP_TOKENS=40
# Local embedding removes the monthly Pinecone integrated-embedding token
# quota from ingestion. Requires scripts/download_local_embedder.py once.
# Use device=mps on Apple Silicon, cpu in the container.
PI_INGEST_EMBEDDING_PROVIDER=local
PI_INGEST_EMBEDDING_DIMENSIONS=1024
PI_INGEST_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
PI_INGEST_LOCAL_EMBEDDING_REVISION=
PI_INGEST_LOCAL_EMBEDDING_DEVICE=cpu
PI_INGEST_LOCAL_EMBEDDING_PATH=.models/multilingual-e5-large
PI_INGEST_LOCAL_EMBEDDING_BATCH_SIZE=16
PI_INGEST_EMBEDDING_TOKENIZER=intfloat/multilingual-e5-large
PI_INGEST_PARSER_VERSION=docling-visual-v2
PI_INGEST_CHUNKER_VERSION=structured-visual-v4-quality
PI_INGEST_SCHEMA_VERSION=3
PI_INGEST_DOCLING_MAX_PAGES=500
PI_INGEST_DOCLING_TIMEOUT_SECONDS=300
PI_INGEST_DOCLING_MAX_CONCURRENCY=2
PI_INGEST_DOCLING_ARTIFACTS_PATH=
PI_INGEST_ENABLE_MALWARE_SCAN=false
PI_INGEST_CLAMAV_SOCKET=
PI_INGEST_SERVICE_BUS_NAMESPACE=
PI_INGEST_SERVICE_BUS_QUEUE_NAME=pi-document-parsing
PI_INGEST_VISUAL_ANALYSIS_ENABLED=false
PI_INGEST_ASSET_MANAGED_IDENTITY_CLIENT_ID=
PI_INGEST_VISUAL_MAX_ASSETS_PER_DOCUMENT=64
PI_INGEST_VISUAL_MAX_PAGES_PER_DOCUMENT=100
PI_INGEST_VISUAL_MIN_AREA_PIXELS=16384
# Restrict this to the address/range of the trusted TLS reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
PI_INGEST_CHROMA_HOST=127.0.0.1
PI_INGEST_CHROMA_PORT=8000
