# Configures pi ingest environment.
PI_INGEST_ENVIRONMENT=development
# Configures pi ingest log level.
PI_INGEST_LOG_LEVEL=INFO
# Configures pi ingest allowed hosts.
PI_INGEST_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Network location for pi ingest metrics pushgateway url.
PI_INGEST_METRICS_PUSHGATEWAY_URL=http://127.0.0.1:9091
# Enables or disables pi ingest docs enabled.
PI_INGEST_DOCS_ENABLED=true
# Configures pi ingest force https.
PI_INGEST_FORCE_HTTPS=false
# Configures pi ingest webhook max body bytes.
PI_INGEST_WEBHOOK_MAX_BODY_BYTES=2097152
# Network location for pi ingest control plane url.
PI_INGEST_CONTROL_PLANE_URL=http://localhost:8001
# Secret value for pi ingest control plane api key; inject it per environment and never commit a real value.
PI_INGEST_CONTROL_PLANE_API_KEY=
# Network location for pi ingest atlassian service url.
PI_INGEST_ATLASSIAN_SERVICE_URL=http://atlassian:8000
# Secret value for pi ingest atlassian service internal api key; inject it per environment and never commit a real value.
PI_INGEST_ATLASSIAN_SERVICE_INTERNAL_API_KEY=
# Enables or disables pi ingest atlassian service primary enabled.
PI_INGEST_ATLASSIAN_SERVICE_PRIMARY_ENABLED=true
# Enables or disables pi ingest atlassian rest fallback enabled.
PI_INGEST_ATLASSIAN_REST_FALLBACK_ENABLED=true
# Configures pi ingest github app id.
PI_INGEST_GITHUB_APP_ID=
# Secret value for pi ingest github private key base64; inject it per environment and never commit a real value.
PI_INGEST_GITHUB_PRIVATE_KEY_BASE64=
# Secret value for pi ingest github webhook secret; inject it per environment and never commit a real value.
PI_INGEST_GITHUB_WEBHOOK_SECRET=
# Configures pi ingest github max file bytes.
PI_INGEST_GITHUB_MAX_FILE_BYTES=1000000
# Secret value for pi ingest pinecone api key; inject it per environment and never commit a real value.
PI_INGEST_PINECONE_API_KEY=
# Configures pi ingest allowed index hosts.
PI_INGEST_ALLOWED_INDEX_HOSTS=
# Network location for pi ingest state table endpoint.
PI_INGEST_STATE_TABLE_ENDPOINT=
# Configures pi ingest state table name.
PI_INGEST_STATE_TABLE_NAME=piingestionstate
# Configures pi ingest state managed identity client id.
PI_INGEST_STATE_MANAGED_IDENTITY_CLIENT_ID=
# Configures pi ingest state backend.
PI_INGEST_STATE_BACKEND=AZURE_TABLE
# Network location for pi ingest state mongodb url.
PI_INGEST_STATE_MONGODB_URL=mongodb://project-intelligence:replace-with-url-encoded-password@mongodb:27017/?authSource=admin
# Configures pi ingest state mongodb database.
PI_INGEST_STATE_MONGODB_DATABASE=project_intelligence_ingestion
# Configures pi ingest state mongodb collection.
PI_INGEST_STATE_MONGODB_COLLECTION=manifests
# Secret value for pi ingest internal api key; inject it per environment and never commit a real value.
PI_INGEST_INTERNAL_API_KEY=
# Configures pi ingest incremental overlap minutes.
PI_INGEST_INCREMENTAL_OVERLAP_MINUTES=5
# Configures pi ingest source page size.
PI_INGEST_SOURCE_PAGE_SIZE=100
# Configures pi ingest max attachment bytes.
PI_INGEST_MAX_ATTACHMENT_BYTES=25000000
# Secret value for pi ingest chunk max tokens; inject it per environment and never commit a real value.
PI_INGEST_CHUNK_MAX_TOKENS=420
# Secret value for pi ingest code chunk max tokens; inject it per environment and never commit a real value.
PI_INGEST_CODE_CHUNK_MAX_TOKENS=350
# Secret value for pi ingest table chunk max tokens; inject it per environment and never commit a real value.
PI_INGEST_TABLE_CHUNK_MAX_TOKENS=300
# Secret value for pi ingest chunk overlap tokens; inject it per environment and never commit a real value.
PI_INGEST_CHUNK_OVERLAP_TOKENS=40
# Local embedding removes the monthly Pinecone integrated-embedding token
# quota from ingestion. Requires scripts/download_local_embedder.py once.
# Use device=mps on Apple Silicon, cpu in the container.
PI_INGEST_EMBEDDING_PROVIDER=local
# Configures pi ingest embedding dimensions.
PI_INGEST_EMBEDDING_DIMENSIONS=1024
# Configures pi ingest local embedding model.
PI_INGEST_LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Configures pi ingest local embedding revision.
PI_INGEST_LOCAL_EMBEDDING_REVISION=
# Configures pi ingest local embedding device.
PI_INGEST_LOCAL_EMBEDDING_DEVICE=cpu
# Configures pi ingest local embedding path.
PI_INGEST_LOCAL_EMBEDDING_PATH=.models/multilingual-e5-large
# Configures pi ingest local embedding batch size.
PI_INGEST_LOCAL_EMBEDDING_BATCH_SIZE=16
# Secret value for pi ingest embedding tokenizer; inject it per environment and never commit a real value.
PI_INGEST_EMBEDDING_TOKENIZER=intfloat/multilingual-e5-large
# Configures pi ingest parser version.
PI_INGEST_PARSER_VERSION=docling-visual-v2
# Configures pi ingest chunker version.
PI_INGEST_CHUNKER_VERSION=structured-visual-v5-enum-registry
# Configures pi ingest schema version.
PI_INGEST_SCHEMA_VERSION=3
# Configures pi ingest docling max pages.
PI_INGEST_DOCLING_MAX_PAGES=500
# Configures pi ingest docling timeout seconds.
PI_INGEST_DOCLING_TIMEOUT_SECONDS=300
# Configures pi ingest docling max concurrency.
PI_INGEST_DOCLING_MAX_CONCURRENCY=2
# Configures pi ingest docling artifacts path.
PI_INGEST_DOCLING_ARTIFACTS_PATH=
# Configures pi ingest enable malware scan.
PI_INGEST_ENABLE_MALWARE_SCAN=false
# Configures pi ingest clamav socket.
PI_INGEST_CLAMAV_SOCKET=
# Configures pi ingest service bus namespace.
PI_INGEST_SERVICE_BUS_NAMESPACE=
# Configures pi ingest service bus queue name.
PI_INGEST_SERVICE_BUS_QUEUE_NAME=pi-document-parsing
# Enables or disables pi ingest visual analysis enabled.
PI_INGEST_VISUAL_ANALYSIS_ENABLED=false
# Configures pi ingest asset managed identity client id.
PI_INGEST_ASSET_MANAGED_IDENTITY_CLIENT_ID=
# Configures pi ingest visual max assets per document.
PI_INGEST_VISUAL_MAX_ASSETS_PER_DOCUMENT=64
# Configures pi ingest visual max pages per document.
PI_INGEST_VISUAL_MAX_PAGES_PER_DOCUMENT=100
# Configures pi ingest visual min area pixels.
PI_INGEST_VISUAL_MIN_AREA_PIXELS=16384
# Restrict this to the address/range of the trusted TLS reverse proxy.
FORWARDED_ALLOW_IPS=127.0.0.1
# Configures pi ingest chroma host.
PI_INGEST_CHROMA_HOST=127.0.0.1
# Configures pi ingest chroma port.
PI_INGEST_CHROMA_PORT=8000
