FROM python:3.12-slim-bookworm AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=2 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    DOCLING_DEVICE=cpu \
    DOCLING_NUM_THREADS=2 \
    DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    PI_INGEST_DOCLING_ARTIFACTS_PATH=/opt/docling-models \
    PI_INGEST_EMBEDDING_TOKENIZER=/opt/e5-tokenizer

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates clamav tesseract-ocr tesseract-ocr-eng tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/* \
    && addgroup --system ingestion \
    && adduser --system --ingroup ingestion ingestion

COPY requirements.txt requirements-worker.txt pyproject.toml README.md ./
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --disable-pip-version-check \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.11.0 torchvision==0.26.0
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --disable-pip-version-check -r requirements-worker.txt
COPY app ./app
COPY scripts ./scripts
RUN HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 docling-tools models download --output-dir /opt/docling-models \
    && HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python -c "from transformers import AutoTokenizer; AutoTokenizer.from_pretrained('intfloat/multilingual-e5-large').save_pretrained('/opt/e5-tokenizer')" \
    && python -m scripts.verify_model_artifacts --write /opt/model-checksums.json /opt/docling-models /opt/e5-tokenizer \
    && chown -R ingestion:ingestion /opt/docling-models /opt/e5-tokenizer /opt/model-checksums.json
RUN python -m pip install --disable-pip-version-check --no-deps .
RUN python -m scripts.generate_sbom /opt/project-intelligence-ingestion-worker.cdx.json

USER ingestion
CMD ["python", "-m", "scripts.run_worker"]
